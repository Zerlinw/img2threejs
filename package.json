{
  "name": "img2threejs",
  "version": "0.1.1",
  "description": "Install and update the img2threejs skill into agent hosts (Hermes, Claude Code, Codex, OpenCode).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "img2threejs": "bin/img2threejs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test bin/img2threejs.mjs-test.mjs",
    "package:check": "npm pack --dry-run",
    "scene:dev": "vite infernal-citadel --host 127.0.0.1 --port 5173",
    "scene:build": "vite build infernal-citadel --outDir ../dist-infernal-citadel",
    "scene:preview": "vite preview infernal-citadel --host 127.0.0.1 --port 5174",
    "scene:pipi:dev": "vite pipi-garden --host 127.0.0.1 --port 5176",
    "scene:pipi:build": "vite build pipi-garden",
    "scene:pipi:preview": "vite preview pipi-garden --host 127.0.0.1 --port 5177",
    "scene:pipi:check": "tsc --noEmit -p pipi-garden/tsconfig.json",
    "scene:pipi:bundle": "npm run scene:pipi:build && node tools/inline-pipi-build.mjs",
    "scene:pipi:test": "node tools/test-pipi-interaction.mjs http://127.0.0.1:5176/ pipi-garden/evidence/interaction-test.json"
  },
  "files": [
    "bin/img2threejs.mjs"
  ],
  "keywords": [
    "img2threejs",
    "threejs",
    "image-to-3d",
    "skill",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/img2threejs/img2threejs.git"
  },
  "bugs": {
    "url": "https://github.com/img2threejs/img2threejs/issues"
  },
  "homepage": "https://github.com/img2threejs/img2threejs#readme",
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
